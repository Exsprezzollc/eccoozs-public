{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-core",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/engine/**/*.ts",
    "src/content/**/*.ts",
    "src/persistence/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "src/**/*.tsx"]
}
