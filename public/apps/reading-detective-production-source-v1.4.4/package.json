{
  "name": "eccoozs-reading-detective",
  "private": true,
  "version": "1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "verify:core": "tsc -p tsconfig.core.json && node scripts/verify-core.cjs",
    "verify:vertical": "tsc -p tsconfig.core.json && node scripts/verify-vertical.cjs",
    "verify:placement": "tsc -p tsconfig.core.json && node scripts/verify-placement.cjs",
    "verify:all": "npm run verify:core && npm run verify:vertical && npm run verify:placement && npm run verify:variation-routing && npm run verify:curriculum-evidence && npm run verify:teaching && npm run verify:educator-insight && npm run verify:junior-source && npm run verify:high-school-document && npm run verify:research-media-decision && npm run verify:curriculum-completeness && npm run verify:capstone-qa && npm run verify:production-assets && npm run verify:learning-repair && npm run verify:prereader-ux && npm run verify:content-stress && npm run verify:phoneme-audio && npm run verify:encoding && npm run verify:narration-motion && npm run verify:ui-static",
    "verify:variation-routing": "tsc -p tsconfig.core.json && node scripts/verify-variation-routing.cjs",
    "verify:curriculum-evidence": "tsc -p tsconfig.core.json && node scripts/verify-curriculum-evidence-board.cjs",
    "verify:ui-static": "tsc -p tsconfig.ui-static.json --pretty false",
    "verify:teaching": "tsc -p tsconfig.core.json && node scripts/verify-teaching-engine.cjs",
    "verify:educator-insight": "tsc -p tsconfig.core.json && node scripts/verify-curriculum-educator-insight.cjs",
    "verify:junior-source": "tsc -p tsconfig.core.json && node scripts/verify-junior-source-intelligence.cjs",
    "verify:high-school-document": "tsc -p tsconfig.core.json && node scripts/verify-high-school-document-intelligence.cjs",
    "verify:research-media-decision": "tsc -p tsconfig.core.json && node scripts/verify-research-media-decision-intelligence.cjs",
    "verify:curriculum-completeness": "tsc -p tsconfig.core.json && node scripts/verify-curriculum-completeness-applied-literature.cjs",
    "verify:capstone-qa": "tsc -p tsconfig.core.json && node scripts/verify-capstone-production-qa.cjs",
    "verify:content-stress": "tsc -p tsconfig.core.json && node scripts/verify-content-stress.cjs",
    "build:browser-qa": "node scripts/build-browser-bundle.cjs",
    "verify:browser-qa": "node scripts/build-browser-bundle.cjs && python scripts/verify-browser-interactive.py",
    "verify:production-assets": "tsc -p tsconfig.core.json && node scripts/verify-production-assets.cjs",
    "qa:production": "npm run verify:all && npm run verify:browser-qa",
    "build:dropin": "npm run build",
    "verify:learning-repair": "tsc -p tsconfig.core.json && node scripts/verify-production-learning-repair.cjs",
    "verify:prereader-ux": "node scripts/verify-prereader-ux.cjs",
    "verify:phoneme-audio": "tsc -p tsconfig.core.json && node scripts/verify-phoneme-audio.cjs",
    "verify:encoding": "tsc -p tsconfig.core.json && node scripts/verify-encoding-activities.cjs",
    "verify:narration-motion": "tsc -p tsconfig.core.json && node scripts/verify-narration-motion.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.3",
    "vite": "5.4.14",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.19 <23",
    "npm": ">=10"
  }
}
